BG_REMOVER_PRO_URL=
BG_REMOVER_INTERNAL_KEY=
GEMINI_API_KEY=
API_KEY=
OPENAI_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Supabase Configurations
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin Authentication
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_ALLOWED_EMAILS=


# Campaign Studio (multi-agent brand visuals). OFF unless CAMPAIGN_STUDIO_ENABLED=true.
CAMPAIGN_STUDIO_ENABLED=
# Optional beta allowlist (comma-separated emails). Empty = every signed-in user. Admins always pass.
CAMPAIGN_STUDIO_ALLOWED_EMAILS=
# Optional model overrides (defaults: gemini-flash-latest / gemini-3.1-pro-preview)
CAMPAIGN_MODEL_FLASH=
CAMPAIGN_MODEL_PRO=
# Wall-clock budget (ms) for one Campaign Studio agent request. Keep below the function limit (vercel.json maxDuration = 60s).
CAMPAIGN_STEP_DEADLINE_MS=

# Vertex AI (post-pay, billed through Cloud Billing) — optional. If GOOGLE_CLOUD_PROJECT is set
# along with either VERTEX_API_KEY or GOOGLE_APPLICATION_CREDENTIALS_JSON, config/ai.ts uses
# Vertex AI instead of the AI Studio key below. Leave unset to keep using the AI Studio key.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Simplest option: a Vertex AI Studio API key (Vertex AI Studio > "Get API key").
VERTEX_API_KEY=
# Alternative: paste a full service-account JSON key file's contents as one line.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# If running Campaign Studio on Vertex, override the rolling "-latest" alias, which Vertex
# does not support, with a concrete model id:
# CAMPAIGN_MODEL_FLASH=gemini-2.5-flash

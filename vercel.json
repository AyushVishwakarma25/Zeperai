{
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/admin/login",
      "destination": "/api/admin/login"
    },
    {
      "source": "/api/admin/check",
      "destination": "/api/admin/check"
    },
    {
      "source": "/api/user/profile",
      "destination": "/api/user/profile"
    },
    {
      "source": "/api/user/invoices",
      "destination": "/api/user/invoices"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/pricing",
      "destination": "/pricing/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/cookies",
      "destination": "/cookies/index.html"
    },
    {
      "source": "/ai-catalog.json",
      "destination": "/api"
    },
    {
      "source": "/.well-known/ai-catalog.json",
      "destination": "/api"
    },
    {
      "source": "/.well-known/ard.json",
      "destination": "/api"
    },
    {
      "source": "/llms.txt",
      "destination": "/api"
    },
    {
      "source": "/.well-known/llms.txt",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|ai-catalog\\.json|\\.well-known/|llms\\.txt|robots\\.txt|sitemap\\.xml|.*\\.[a-zA-Z0-9]+).*)",
      "destination": "/index.html"
    }
  ]
}

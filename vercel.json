{
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/background-remover",
      "destination": "/tools/background-remover",
      "permanent": true
    },
    {
      "source": "/background-remove",
      "destination": "/tools/background-remover",
      "permanent": true
    },
    {
      "source": "/tools/background-remove",
      "destination": "/tools/background-remover",
      "permanent": true
    },
    {
      "source": "/cookie-policy",
      "destination": "/cookies",
      "permanent": true
    },
    {
      "source": "/legal/cookie-policy",
      "destination": "/cookies",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/admin/login",
      "destination": "/api/admin/login"
    },
    {
      "source": "/api/admin/check",
      "destination": "/api/admin/check"
    },
    {
      "source": "/api/user/profile",
      "destination": "/api/user/profile"
    },
    {
      "source": "/api/user/invoices",
      "destination": "/api/user/invoices"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/ai-catalog.json",
      "destination": "/api"
    },
    {
      "source": "/.well-known/ai-catalog.json",
      "destination": "/api"
    },
    {
      "source": "/.well-known/ard.json",
      "destination": "/api"
    },
    {
      "source": "/llms.txt",
      "destination": "/api"
    },
    {
      "source": "/.well-known/llms.txt",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|ai-catalog\\.json|\\.well-known/|llms\\.txt|robots\\.txt|sitemap\\.xml|.*\\.[a-zA-Z0-9]+).*)",
      "destination": "/index.html"
    }
  ]
}
